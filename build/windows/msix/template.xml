<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="soha-app"
        Arguments=""
        InstallLocation="C:\Program Files\OpenSoha\Soha">
    </Installer>
    <PackageInformation
        PackageName="Soha"
        PackageDisplayName="Soha"
        PublisherName="CN=OpenSoha"
        PublisherDisplayName="OpenSoha"
        Version="0.1.0.0"
        PackageDescription="SohaCrossPlatformClient">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.opensoha.app"
                Description="SohaCrossPlatformClient"
                DisplayName="Soha"
                ExecutableName="soha-app"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Soha</DisplayName>
            <PublisherDisplayName>OpenSoha</PublisherDisplayName>
            <Description>SohaCrossPlatformClient</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="soha-app.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
